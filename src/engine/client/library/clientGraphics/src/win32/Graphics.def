#ifndef INCLUDED_Graphics_DEF
#define INCLUDED_Graphics_DEF

// ======================================================================

typedef unsigned short Index;

enum GlFillMode
{
	GFM_wire,
	GFM_solid
};

enum GlCullMode
{
	GCM_none,
	GCM_clockwise,
	GCM_counterClockwise
};

enum GlScreenShotFormat
{
	GSSF_tga,
	GSSF_bmp,
	GSSF_jpg
};

struct GlMatrix4x4
{
	float matrix[4][4];
};

// Currently maps to DX9 D3DXIMAGE_FILEFORMAT 

enum Gl_imageFormat
{
    GLIF_bmp,
    GLIF_jpg,
    GLIF_tga,
    GLIF_png,
    GLIF_dds,
    GLIF_ppm,
    GLIF_dib,
    GLIF_hdr,
    GLIF_pfm
};

struct Gl_pixelRect
{
	void    *pixels;
	unsigned pitch; // y-stride
	unsigned colorBits;
	unsigned alphaBits;
};

struct Gl_rect
{
	int x0, y0, x1, y1;
};

// ======================================================================

#endif

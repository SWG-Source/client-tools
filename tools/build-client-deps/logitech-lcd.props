<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Optional import after the executable's ItemDefinitionGroups. -->
  <PropertyGroup Condition="'$(Platform)'=='x64' And '$(ProjectName)'=='SwgClient'">
    <SwgPythonExecutable Condition="'$(SwgPythonExecutable)'==''">python</SwgPythonExecutable>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64' And '$(ProjectName)'=='SwgClient'">
    <Link>
      <AdditionalLibraryDirectories>$(SwgLogitechLcdSdkDir)\Lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="ValidateSwgLogitechLcd" BeforeTargets="PrepareForBuild;Link" Condition="'$(Platform)'=='x64' And '$(ProjectName)'=='SwgClient'">
    <Error Condition="'$(SwgLogitechLcdSdkDir)'=='' Or !Exists('$(SwgLogitechLcdSdkDir)\Lib\x64\lglcd.lib')" Text="Set SwgLogitechLcdSdkDir to the extracted official legacy LCDSDK root containing Lib\x64\lglcd.lib. No SDK is bundled; see dependency documentation." />
    <Exec Command="&quot;$(SwgPythonExecutable)&quot; &quot;$(MSBuildThisFileDirectory)validate-logitech-lcd.py&quot; &quot;$(SwgLogitechLcdSdkDir)\Lib\x64\lglcd.lib&quot;" />
  </Target>
</Project>

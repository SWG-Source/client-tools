<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SwgPythonExecutable Condition="'$(SwgPythonExecutable)'==''">python</SwgPythonExecutable>
    <SwgClientDepsDir Condition="'$(SwgClientDepsDir)'==''">$(SwgSourceRoot)compile\deps\v120\$(Platform)\$(Configuration)\</SwgClientDepsDir>
    <SwgClientDepsPath>$(SwgClientDepsDir)\</SwgClientDepsPath>
  </PropertyGroup>
  <Target Name="ValidateSwgClientDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PlatformToolset)'!='v120'" Text="Client dependency builds currently require verified VS2013 v120." />
    <Error Condition="'$(SwgJpegArchive)'=='' Or !Exists('$(SwgJpegArchive)')" Text="Set SwgJpegArchive to the official pinned JPEG6b source archive. See tools/build-client-deps/README.md; builds are offline." />
  </Target>
  <Target Name="BuildSwgClientDependencies" BeforeTargets="Link" DependsOnTargets="ValidateSwgClientDependencies">
    <Exec Command="&quot;$(SwgPythonExecutable)&quot; &quot;$(MSBuildThisFileDirectory)build.py&quot; --output &quot;$(SwgClientDepsPath).&quot; --vcvars &quot;$(VCInstallDir)vcvarsall.bat&quot; --platform &quot;$(Platform)&quot; --configuration &quot;$(Configuration)&quot; --jpeg-archive &quot;$(SwgJpegArchive)&quot;" />
  </Target>
</Project>

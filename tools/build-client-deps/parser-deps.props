<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- SwgClient x64 only. Win32 keeps its existing providers and runtime DLL. -->
  <PropertyGroup>
    <SwgParserDepsDir Condition="'$(SwgParserDepsDir)'==''">$(SwgSourceRoot)compile\deps\parsers-v120\$(Platform)\$(Configuration)\</SwgParserDepsDir>
    <SwgParserDepsPath>$(SwgParserDepsDir)\</SwgParserDepsPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>$(SwgParserDepsPath)pcre.lib;$(SwgParserDepsPath)libxml2.lib;$([MSBuild]::Unescape($([System.String]::Copy('%(Link.AdditionalDependencies)').Replace('libpcre.a;', '').Replace('libxml2-win32-release.lib;', '').Replace('libxml2-win32-debug.lib;', ''))))</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="ValidateSwgParserDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PlatformToolset)'!='v120'" Text="Legacy parser builds require verified VS2013 v120." />
    <Error Condition="'$(SwgPcreArchive)'=='' Or !Exists('$(SwgPcreArchive)')" Text="Set SwgPcreArchive to pinned PCRE 4.1 source. See tools/build-client-deps/PARSERS.md." />
    <Error Condition="'$(SwgLibxmlArchive)'=='' Or !Exists('$(SwgLibxmlArchive)')" Text="Set SwgLibxmlArchive to pinned libxml2 2.6.7 source. Builds are offline." />
  </Target>
  <Target Name="BuildSwgParserDependencies" BeforeTargets="Link" DependsOnTargets="ValidateSwgParserDependencies">
    <Exec Command="&quot;$(SwgPythonExecutable)&quot; &quot;$(MSBuildThisFileDirectory)build-parsers.py&quot; --output &quot;$(SwgParserDepsPath).&quot; --vcvars &quot;$(VCInstallDir)vcvarsall.bat&quot; --platform &quot;$(Platform)&quot; --configuration &quot;$(Configuration)&quot; --pcre-archive &quot;$(SwgPcreArchive)&quot; --libxml-archive &quot;$(SwgLibxmlArchive)&quot;" />
  </Target>
  <Target Name="DeploySwgParserRuntime" AfterTargets="Link" DependsOnTargets="BuildSwgParserDependencies">
    <!-- The original XML ABI imports xmlFree as data; deploy its matching genuine DLL. -->
    <Copy SourceFiles="$(SwgParserDepsPath)libxml2.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

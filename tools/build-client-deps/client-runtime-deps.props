<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Only SwgClient x64 imports this sheet; consumer ABI macros are unchanged. -->
  <Import Project="dependency-build.props" />
  <ItemDefinitionGroup>
    <Link>
      <!-- The legacy explicit STL-debug archive is x86. Consumers request the
           ordinary static ABI, including Debug; /MTd is not _STLP_DEBUG. -->
      <AdditionalDependencies>$(SwgClientDepsPath)stlport.lib;$(SwgClientDepsPath)vivoxSharedWrapper.lib;$([System.String]::Copy('%(Link.AdditionalDependencies)').Replace('stlport_vc71_stldebug_static.lib;', '').Replace('vivoxSharedWrapper_Release.lib;', '').Replace('vivoxSharedWrapper_release.lib;', '').Replace('vivoxSharedWrapper_Debug.lib;', '').Replace('vivoxSharedWrapper_debug.lib;', ''))</AdditionalDependencies>
      <!-- Real source-built STLport above replaces this observed autolink name. -->
      <IgnoreSpecificDefaultLibraries>stlport_vc71_static.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
</Project>

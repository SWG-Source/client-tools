<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported only for x64 renderer projects. Win32 keeps its existing providers. -->
  <PropertyGroup>
    <SwgPythonExecutable Condition="'$(SwgPythonExecutable)'==''">python</SwgPythonExecutable>
    <SwgClientDepsDir Condition="'$(SwgClientDepsDir)'==''">$(SwgSourceRoot)compile\deps\v120\$(Platform)\$(Configuration)\</SwgClientDepsDir>
    <SwgClientDepsPath>$(SwgClientDepsDir)\</SwgClientDepsPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_STLP_DONT_FORCE_MSVC_LIB_NAME;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(SwgClientDepsPath)stlport.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="ValidateSwgRendererDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PlatformToolset)'!='v120'" Text="Renderer dependency builds currently require verified VS2013 v120." />
    <Error Condition="'$(SwgJpegArchive)'=='' Or !Exists('$(SwgJpegArchive)')" Text="Set SwgJpegArchive to the official pinned JPEG6b source archive. See tools/build-client-deps/README.md; builds are offline." />
    <Error Condition="!Exists('$(DXSDK_DIR)\Include\DxErr.h') Or !Exists('$(DXSDK_DIR)\Lib\x64\DxErr.lib')" Text="DXSDK_DIR must identify the genuine June 2010 DirectX SDK with x64 DxErr.lib." />
    <Error Condition="!Exists('$(WindowsSdkDir)Lib\winv6.3\um\x64\ddraw.lib')" Text="The verified v120 renderer requires the Windows 8.1 SDK x64 DirectDraw import library." />
  </Target>
  <Target Name="BuildSwgRendererDependencies" BeforeTargets="Link" DependsOnTargets="ValidateSwgRendererDependencies">
    <Exec Command="&quot;$(SwgPythonExecutable)&quot; &quot;$(MSBuildThisFileDirectory)build.py&quot; --output &quot;$(SwgClientDepsPath).&quot; --vcvars &quot;$(VCInstallDir)vcvarsall.bat&quot; --platform &quot;$(Platform)&quot; --configuration &quot;$(Configuration)&quot; --jpeg-archive &quot;$(SwgJpegArchive)&quot;" />
  </Target>
</Project>

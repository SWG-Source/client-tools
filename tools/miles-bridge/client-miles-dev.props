<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Explicit development build only. The ordinary game still uses direct Miles. -->
  <PropertyGroup>
    <ClientMilesDevelopmentRoot>$(SwgSourceRoot)compile\miles-dev\x64\</ClientMilesDevelopmentRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProjectName)'=='clientAudio' Or '$(ProjectName)'=='clientGraphics' Or '$(ProjectName)'=='SwgClient'">
    <OutDir>$(ClientMilesDevelopmentRoot)$(ProjectName)\$(Configuration)\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
    <TargetName Condition="'$(ProjectName)'=='SwgClient' And '$(Configuration)'=='Debug'">SwgClient_d</TargetName>
    <TargetName Condition="'$(ProjectName)'=='SwgClient' And '$(Configuration)'=='Release'">SwgClient_r</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(ProjectName)'=='clientAudio' Or '$(ProjectName)'=='clientGraphics'">
    <ClCompile>
      <PreprocessorDefinitions>CLIENT_MILES_DEV_FACADE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(ProjectName)'=='SwgClient'">
    <Link>
      <!-- Explicit path prevents fallback to an older direct-Miles Audio or Graphics archive. -->
      <AdditionalDependencies>$(ClientMilesPipeLibrary);$(ClientMilesWorkerLibrary);$([MSBuild]::Unescape($([System.String]::Copy('%(Link.AdditionalDependencies)').Replace('clientAudio.lib;', '$(ClientMilesDevelopmentRoot)clientAudio\$(Configuration)\clientAudio.lib;').Replace('clientGraphics.lib;', '$(ClientMilesDevelopmentRoot)clientGraphics\$(Configuration)\clientGraphics.lib;'))))</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="ValidateMilesDevelopmentConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)'!='x64' Or ('$(Configuration)'!='Debug' And '$(Configuration)'!='Release') Or '$(PlatformToolset)'!='v120'" Text="The experimental Miles facade requires Debug|x64 or Release|x64 with VS2013 v120. Other configurations are not qualified." />
  </Target>
  <Target Name="ValidateMilesDevelopmentLink" BeforeTargets="Link" Condition="'$(ProjectName)'=='SwgClient'">
    <Error Condition="'$(ClientMilesPipeLibrary)'=='' Or !Exists('$(ClientMilesPipeLibrary)')" Text="Set ClientMilesPipeLibrary to the genuine matching-configuration x64 pipe archive built by tools/miles-bridge/build.py." />
    <Error Condition="'$(ClientMilesWorkerLibrary)'=='' Or !Exists('$(ClientMilesWorkerLibrary)')" Text="Set ClientMilesWorkerLibrary to the matching-configuration x64 engine-worker archive built against this engine checkout." />
    <Error Condition="!Exists('$(ClientMilesDevelopmentRoot)clientAudio\$(Configuration)\clientAudio.lib')" Text="Build clientAudio with ClientMilesDevelopment=true before linking the development game." />
    <Error Condition="!Exists('$(ClientMilesDevelopmentRoot)clientGraphics\$(Configuration)\clientGraphics.lib')" Text="Build clientGraphics with ClientMilesDevelopment=true before linking the development game." />
  </Target>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported only by generated x64 projects, before Microsoft.Cpp.targets. -->
  <PropertyGroup>
    <SwgSourceRoot>$(MSBuildThisFileDirectory)..\..\src\</SwgSourceRoot>
    <OutDir>$(SwgSourceRoot)compile\x64\$(ProjectName)\$(Configuration)\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <PrecompiledHeaderOutputFile>$(IntDir)$(ProjectName).pch</PrecompiledHeaderOutputFile>
      <ProgramDataBaseFileName>$(IntDir)$(ProjectName)-compile.pdb</ProgramDataBaseFileName>
      <AssemblerListingLocation>$(IntDir)</AssemblerListingLocation>
      <AdditionalIncludeDirectories Condition="'$(DXSDK_DIR)'!=''">$(DXSDK_DIR)\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ResourceCompile>
      <ResourceOutputFileName>$(IntDir)%(Filename).res</ResourceOutputFileName>
    </ResourceCompile>
    <Link>
      <TargetMachine>MachineX64</TargetMachine>
      <!-- Unresolved or duplicate symbols must fail the x64 client link. -->
      <ForceFileOutput Condition="'$(ProjectName)'=='SwgClient'" />
      <!-- Preserve the exercised PCRE recursion corpus with wider x64 stack frames. -->
      <StackReserveSize Condition="'$(ProjectName)'=='SwgClient' And '$(Platform)'=='x64'">2097152</StackReserveSize>
      <AdditionalLibraryDirectories Condition="'$(DXSDK_DIR)'!=''">$(DXSDK_DIR)\Lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <Lib><TargetMachine>MachineX64</TargetMachine></Lib>
  </ItemDefinitionGroup>
  <Import Project="..\build-client-deps\renderer-deps.props" Condition="'$(ProjectName)'=='Direct3d9' Or '$(ProjectName)'=='Direct3d9_ffp' Or '$(ProjectName)'=='Direct3d9_vsps'" />
  <Import Project="..\build-client-deps\logitech-lcd.props" Condition="'$(ProjectName)'=='SwgClient'" />
  <Import Project="..\build-client-deps\client-runtime-deps.props" Condition="'$(ProjectName)'=='SwgClient'" />
  <Import Project="..\build-client-deps\parser-deps.props" Condition="'$(ProjectName)'=='SwgClient'" />
</Project>

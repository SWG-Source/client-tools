<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- This branch targets a 64-bit client, so default Platform to x64 when a
       build does not specify one. Invocations that pass /p:Platform (including
       scripts/Build-X64Client.ps1 and any solution build, which supplies the
       platform per project) are unaffected. -->
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <SwgX64DependenciesDir>$(MSBuildThisFileDirectory)deps\x64</SwgX64DependenciesDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(TargetDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_HAS_AUTO_PTR_ETC=1;_SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'Win32'">
    <ClCompile>
      <PreprocessorDefinitions>_HAS_AUTO_PTR_ETC=1;_SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
